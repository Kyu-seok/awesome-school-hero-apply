# 복사해서 .env로 쓴다. 저장소에는 .env.example만 올린다.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# 비우면 로컬 PostgreSQL(유닉스 소켓, 현재 OS 사용자)의 hero_school DB를 쓴다.
DATABASE_URL=postgres://hero_school:hero_school@localhost:5432/hero_school
LANDING_PROGRAM_SLUG=ai-hero
# 익명 신청 접수 제한(DRF 형식).
APPLICATION_SUBMIT_THROTTLE_RATE=10/hour
# Celery 브로커(redis).
CELERY_BROKER_URL=redis://redis:6379/0
# 메일. 배포는 Gmail SMTP(앱 비밀번호). 비우면 console 백엔드로 로그에만 찍힌다.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=kyuships@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=히어로스쿨 <kyuships@gmail.com>
# seed_demo 명령이 만드는 데모 운영자 계정(is_staff, Django admin 접근 불가).
DEMO_OPERATOR_USERNAME=demo-operator
DEMO_OPERATOR_PASSWORD=hero-demo-2026
