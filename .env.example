# 프로덕션 환경변수. 복사해서 .env로 쓴다(cp .env.example .env). 저장소에는 .env.example만 올린다.
# compose.prod.yaml이 이 파일을 web 컨테이너(이후 worker, beat도)에 그대로 넘긴다.

# --- Django ---
# 필수. 길고 무작위인 값: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# 프로덕션에서는 반드시 0. 0이면 없는 경로에 404 페이지를 보여준다.
DJANGO_DEBUG=0
# 쉼표로 구분. 127.0.0.1/localhost는 미니 PC 안에서 curl http://127.0.0.1:8120 으로 확인할 때 쓴다.
DJANGO_ALLOWED_HOSTS=hero-school.kyuships.com,127.0.0.1,localhost
# 쉼표로 구분, 스킴 포함. 로그인·관리자 페이지 폼의 CSRF Origin 검사에 쓴다.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hero-school.kyuships.com
# 1이면 X-Forwarded-Proto: https 를 HTTPS 요청으로 믿는다. nginx 뒤에서만 1로 둔다.
DJANGO_BEHIND_PROXY=1
# 1이면 세션·CSRF 쿠키를 HTTPS에서만 보낸다. 그래서 http://127.0.0.1:8120 에서는 로그인할 수 없다.
DJANGO_SECURE_COOKIES=1
# HTTPS 리다이렉트와 HSTS는 Cloudflare(Always Use HTTPS)가 맡는다. 1로 두면 http://127.0.0.1:8120
# 확인이 https로 리다이렉트된다.
DJANGO_SECURE_SSL_REDIRECT=0
# HSTS는 되돌리기 어렵다. 도메인 전체가 HTTPS로만 서비스되는지 확인한 뒤에만 올린다(예: 31536000).
DJANGO_SECURE_HSTS_SECONDS=0

# --- 데이터베이스 ---
# compose.prod.yaml이 postgres 컨테이너를 이 비밀번호로 만들고, web에는 DATABASE_URL을 조립해 넘긴다.
# URL에 들어가므로 영문·숫자만 쓴다: openssl rand -hex 24
# 첫 배포 뒤에 바꾸면 기존 DB 볼륨의 비밀번호와 어긋난다.
POSTGRES_PASSWORD=change-me
# compose 밖에서(로컬 개발) 직접 띄울 때만 쓴다. 비우면 로컬 PostgreSQL(유닉스 소켓)의 hero_school DB.
# DATABASE_URL=postgres://hero_school:hero_school@localhost:5432/hero_school

# --- 콘텐츠 ---
# 랜딩 페이지(/)에서 보여줄 대표 교육의 슬러그.
LANDING_PROGRAM_SLUG=ai-hero
# 업로드 파일 위치. compose.prod.yaml은 /app/media 볼륨으로 고정하므로 로컬 개발에서만 바꾼다.
# DJANGO_MEDIA_ROOT=
